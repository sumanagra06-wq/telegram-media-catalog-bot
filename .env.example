# Create the bot with @BotFather. Never commit the real token.
BOT_TOKEN=123456:replace_me

# One or more comma-separated Telegram user IDs. Owners are always authorized.
OWNER_IDS=123456789

# Both must be private channels where the bot can post, edit, pin and delete messages.
FILE_DATABASE_CHANNEL_ID=-1001111111111
USER_DATABASE_CHANNEL_ID=-1002222222222

# Railway public URL, without a trailing slash.
# You may alternatively set RAILWAY_PUBLIC_DOMAIN; the app will derive https:// from it.
WEBHOOK_BASE_URL=https://your-service.up.railway.app
WEBHOOK_PATH=/telegram/webhook
WEBHOOK_SECRET_TOKEN=replace_with_a_long_random_secret

HOST=0.0.0.0
PORT=8080
LOG_LEVEL=INFO

# Requested files are always save/forward-enabled and auto-delete from the bot chat in 5 minutes.
